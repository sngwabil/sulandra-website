<script type="module">
  // Firebase is optional and must be configured at deployment time.
  // Define window.SULANDRA_FIREBASE_CONFIG before this module runs.
  // Do not commit API keys or deployment credentials to this repository.
  const firebaseConfig = window.SULANDRA_FIREBASE_CONFIG;

  if (firebaseConfig && firebaseConfig.apiKey && firebaseConfig.projectId) {
    const [{ initializeApp }, { getAnalytics, isSupported }] = await Promise.all([
      import("https://www.gstatic.com/firebasejs/12.7.0/firebase-app.js"),
      import("https://www.gstatic.com/firebasejs/12.7.0/firebase-analytics.js"),
    ]);

    const app = initializeApp(firebaseConfig);
    if (await isSupported()) getAnalytics(app);
  } else {
    console.info("Firebase analytics is not configured for this deployment.");
  }
</script>
