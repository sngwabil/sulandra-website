{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.coding-terminal",
    "watchPatterns": [
      "coding-terminal-worker/**",
      "Dockerfile.coding-terminal",
      "scripts/install-terminal-gateway-ha.mjs",
      "scripts/install-workspace-ide-live-preview.mjs",
      "scripts/fix-workspace-proxy-abort.mjs",
      "scripts/fix-workspace-proxy-streaming.mjs",
      "scripts/fix-workspace-browser-session.mjs",
      "scripts/verify-workspace-browser-session.mjs",
      "scripts/fix-workspace-ticket-cors.mjs",
      "scripts/verify-workspace-ticket-cors.mjs",
      "terminal-session-agent/**",
      "Dockerfile.terminal-session",
      "terminal-execution-plane/**",
      "Dockerfile.terminal-executor",
      "infra/terminal-vps/**",
      ".github/workflows/terminal-vps-deploy.yml",
      "railway.terminal-worker.json"
    ]
  },
  "deploy": {
    "startCommand": "node /gateway/server.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "multiRegionConfig": {
      "sfo": {
        "numReplicas": 1
      },
      "us-east4-eqdc4a": {
        "numReplicas": 1
      }
    },
    "overlapSeconds": "30",
    "drainingSeconds": "30"
  }
}
