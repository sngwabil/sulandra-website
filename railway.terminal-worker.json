{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.coding-terminal",
    "watchPatterns": [
      "coding-terminal-worker/**",
      "scripts/install-terminal-gateway-ha.mjs",
      "Dockerfile.coding-terminal",
      "railway.terminal-worker.json"
    ]
  },
  "deploy": {
    "startCommand": "node /gateway/server.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS",
    "multiRegionConfig": {
      "us-west2": {
        "numReplicas": 1
      },
      "us-east4-eqdc4a": {
        "numReplicas": 1
      }
    },
    "overlapSeconds": "30",
    "drainingSeconds": "30"
  }
}
