FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PORT=8081 \
    DOCKER_SOCKET_PATH=/var/run/docker.sock \
    TERMINAL_SEED_PATH=/seed \
    TERMINAL_WORKSPACE_ROOT=/workspaces \
    TERMINAL_STATE_ROOT=/state

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 terminalctl \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin terminalctl

WORKDIR /app
COPY terminal-execution-plane/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY terminal-execution-plane/server.mjs ./server.mjs
COPY scripts/install-terminal-industry-hardening.mjs /tmp/install-terminal-industry-hardening.mjs
COPY scripts/fix-terminal-resource-monitor.mjs /tmp/fix-terminal-resource-monitor.mjs
COPY scripts/install-workspace-ide-live-preview.mjs /tmp/install-workspace-ide-live-preview.mjs
RUN node /tmp/install-terminal-industry-hardening.mjs /app/server.mjs \
    && node /tmp/fix-terminal-resource-monitor.mjs /app/server.mjs \
    && node /tmp/install-workspace-ide-live-preview.mjs /app/server.mjs \
    && node --check /app/server.mjs \
    && rm -f /tmp/install-terminal-industry-hardening.mjs /tmp/fix-terminal-resource-monitor.mjs /tmp/install-workspace-ide-live-preview.mjs

RUN mkdir -p /workspaces /state /seed \
    && chown -R 10001:10001 /workspaces /state /app

EXPOSE 8081
USER 10001:10001
CMD ["node", "server.mjs"]
