FROM node:22-bookworm-slim

ARG NPM_VERSION=10.9.9

ENV NODE_ENV=production \
    PORT=8081 \
    DOCKER_SOCKET_PATH=/var/run/docker.sock \
    TERMINAL_SEED_PATH=/seed \
    TERMINAL_WORKSPACE_ROOT=/workspaces \
    TERMINAL_STATE_ROOT=/state \
    TERMINAL_AUDIT_ROOT=/state/audit \
    TERMINAL_AUDIT_RETENTION_DAYS=2190

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 terminalctl \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin terminalctl

# Node 22.23.2 ships npm 10.9.8 with bundled tar 7.5.11 (CVE-2026-59873).
# Pin the patched npm 10 line; npm 10.9.9 bundles tar 7.5.22.
RUN npm install --global "npm@${NPM_VERSION}" --no-audit --no-fund \
    && test "$(npm --version)" = "${NPM_VERSION}"

WORKDIR /app
COPY terminal-execution-plane/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY terminal-execution-plane/server.mjs ./server.mjs
COPY scripts/install-terminal-industry-hardening.mjs /tmp/install-terminal-industry-hardening.mjs
COPY scripts/fix-terminal-resource-monitor.mjs /tmp/fix-terminal-resource-monitor.mjs
COPY scripts/install-workspace-ide-live-preview.mjs /tmp/install-workspace-ide-live-preview.mjs
COPY scripts/fix-workspace-proxy-abort.mjs /tmp/fix-workspace-proxy-abort.mjs
COPY scripts/fix-workspace-ide-agent-transport.mjs /tmp/fix-workspace-ide-agent-transport.mjs
COPY scripts/fix-workspace-proxy-streaming.mjs /tmp/fix-workspace-proxy-streaming.mjs
COPY scripts/install-terminal-security-audit.mjs /tmp/install-terminal-security-audit.mjs
COPY scripts/install-terminal-history-proxy.mjs /tmp/install-terminal-history-proxy.mjs
COPY scripts/install-terminal-session-recovery.mjs /tmp/install-terminal-session-recovery.mjs
COPY scripts/install-terminal-executor-ha-reconcile.mjs /tmp/install-terminal-executor-ha-reconcile.mjs
COPY scripts/install-codebase-workspace-reuse.mjs /tmp/install-codebase-workspace-reuse.mjs
COPY scripts/install-terminal-unrestricted-dev.mjs /tmp/install-terminal-unrestricted-dev.mjs
COPY scripts/fix-codebase-independent-workspace.mjs /tmp/fix-codebase-independent-workspace.mjs
COPY scripts/harden-codebase-project-persistence.mjs /tmp/harden-codebase-project-persistence.mjs
COPY scripts/install-codebase-project-control.mjs /tmp/install-codebase-project-control.mjs
COPY scripts/install-codebase-preview-control.mjs /tmp/install-codebase-preview-control.mjs
COPY scripts/fix-codebase-public-git-clone.mjs /tmp/fix-codebase-public-git-clone.mjs
COPY scripts/install-codebase-explorer-file-management.mjs /tmp/install-codebase-explorer-file-management.mjs
COPY scripts/fix-codebase-project-session-recovery.mjs /tmp/fix-codebase-project-session-recovery.mjs
COPY scripts/install-terminal-session-startup-diagnostics.mjs /tmp/install-terminal-session-startup-diagnostics.mjs
RUN node /tmp/install-terminal-industry-hardening.mjs /app/server.mjs \
    && node /tmp/fix-terminal-resource-monitor.mjs /app/server.mjs \
    && node /tmp/install-workspace-ide-live-preview.mjs /app/server.mjs \
    && node /tmp/fix-workspace-proxy-abort.mjs /app/server.mjs \
    && node /tmp/fix-workspace-ide-agent-transport.mjs /app/server.mjs \
    && node /tmp/fix-workspace-proxy-streaming.mjs /app/server.mjs \
    && node /tmp/install-terminal-security-audit.mjs /app/server.mjs \
    && node /tmp/install-terminal-history-proxy.mjs /app/server.mjs \
    && node /tmp/install-terminal-session-recovery.mjs /app/server.mjs \
    && node /tmp/install-terminal-executor-ha-reconcile.mjs /app/server.mjs \
    && node /tmp/install-codebase-workspace-reuse.mjs /app/server.mjs \
    && node /tmp/install-terminal-unrestricted-dev.mjs /app/server.mjs executor \
    && node /tmp/fix-codebase-independent-workspace.mjs /app/server.mjs \
    && node /tmp/harden-codebase-project-persistence.mjs /app/server.mjs \
    && node /tmp/install-codebase-project-control.mjs /app/server.mjs \
    && node /tmp/install-codebase-preview-control.mjs /app/server.mjs \
    && node /tmp/fix-codebase-public-git-clone.mjs /app/server.mjs \
    && node /tmp/install-codebase-explorer-file-management.mjs /app/server.mjs \
    && node /tmp/fix-codebase-project-session-recovery.mjs /app/server.mjs \
    && node /tmp/install-terminal-session-startup-diagnostics.mjs /app/server.mjs executor \
    && node --check /app/server.mjs \
    && grep -Fq 'CODEBASE_WORKSPACE_REUSE_V1' /app/server.mjs \
    && grep -Fq 'CODEBASE_INDEPENDENT_WORKSPACE_V1' /app/server.mjs \
    && grep -Fq 'CODEBASE_PROJECT_PERSISTENCE_V2' /app/server.mjs \
    && grep -Fq 'CODEBASE_PROJECT_CONTROL_V1' /app/server.mjs \
    && grep -Fq 'CODEBASE_PREVIEW_ENVIRONMENTS_CONTROL_V1' /app/server.mjs \
    && grep -Fq 'CODEBASE_PUBLIC_GIT_CLONE_V1' /app/server.mjs \
    && grep -Fq "'GIT_TERMINAL_PROMPT=0', 'git', ...gitArgs" /app/server.mjs \
    && grep -Fq 'CODEBASE_EXPLORER_FILE_OPERATIONS_V1' /app/server.mjs \
    && grep -Fq 'CODEBASE_PROJECT_SESSION_RECOVERY_V1' /app/server.mjs \
    && grep -Fq 'TERMINAL_SESSION_STARTUP_DIAGNOSTICS_V1' /app/server.mjs \
    && grep -Fq "workspaceKind: 'codebase'" /app/server.mjs \
    && grep -Fq "gitBacked: Boolean(workspace.repository)" /app/server.mjs \
    && grep -Fq 'restoreCodebaseWorkspaceRegistry(owner)' /app/server.mjs \
    && grep -Fq 'consolidateCodebaseProjects(workspace, reusableCodebase)' /app/server.mjs \
    && grep -Fq '.sulandra-codebase-owner.json' /app/server.mjs \
    && grep -Fq '.sulandra-projects:/projects:rw' /app/server.mjs \
    && grep -Fq '.sulandra-home:/home/terminal:rw' /app/server.mjs \
    && grep -Fq '${workspace.hostCwd}:/workspace:ro' /app/server.mjs \
    && grep -Fq "WorkingDir: '/projects'" /app/server.mjs \
    && grep -Fq 'ReadonlyRootfs: false' /app/server.mjs \
    && grep -Fq "app.post('/v1/workspaces/:workspaceId/codebase/projects/clone'" /app/server.mjs \
    && grep -Fq "app.put('/v1/workspaces/:workspaceId/codebase/projects/:project/file'" /app/server.mjs \
    && grep -Fq "app.post('/v1/workspaces/:workspaceId/codebase/projects/:project/move'" /app/server.mjs \
    && grep -Fq "app.get('/v1/workspaces/:workspaceId/codebase/projects/:project/railway/preview'" /app/server.mjs \
    && grep -Fq "app.post('/v1/workspaces/:workspaceId/codebase/projects/:project/railway/deploy'" /app/server.mjs \
    && grep -Fq 'activeProject: workspace.activeProject' /app/server.mjs \
    && grep -Fq 'inspect.State?.Restarting' /app/server.mjs \
    && grep -Fq 'resetCodebaseSessionCwds(workspace)' /app/server.mjs \
    && grep -Fq 'HTTP_PROXY=${egressProxyUrl}' /app/server.mjs \
    && grep -Fq 'TERMINAL_TMPFS_BYTES || 1_073_741_824' /app/server.mjs \
    && grep -Fq 'size=${terminalTmpfsBytes},mode=1777' /app/server.mjs \
    && grep -Fq 'tmpfsBytes: terminalTmpfsBytes' /app/server.mjs \
    && rm -f /tmp/install-terminal-industry-hardening.mjs /tmp/fix-terminal-resource-monitor.mjs /tmp/install-workspace-ide-live-preview.mjs /tmp/fix-workspace-proxy-abort.mjs /tmp/fix-workspace-ide-agent-transport.mjs /tmp/fix-workspace-proxy-streaming.mjs /tmp/install-terminal-security-audit.mjs /tmp/install-terminal-history-proxy.mjs /tmp/install-terminal-session-recovery.mjs /tmp/install-terminal-executor-ha-reconcile.mjs /tmp/install-codebase-workspace-reuse.mjs /tmp/install-terminal-unrestricted-dev.mjs /tmp/fix-codebase-independent-workspace.mjs /tmp/harden-codebase-project-persistence.mjs /tmp/install-codebase-project-control.mjs /tmp/install-codebase-preview-control.mjs /tmp/fix-codebase-public-git-clone.mjs /tmp/install-codebase-explorer-file-management.mjs /tmp/fix-codebase-project-session-recovery.mjs /tmp/install-terminal-session-startup-diagnostics.mjs

RUN mkdir -p /workspaces /state /state/audit /seed \
    && chown -R 10001:10001 /workspaces /state /app

EXPOSE 8081
USER 10001:10001
CMD ["node", "server.mjs"]