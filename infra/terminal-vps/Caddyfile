{
    email {$ACME_EMAIL}
    # Keep the admin API private to the Caddy container. This enables graceful
    # in-process config reloads during blue/green executor promotion without
    # exposing the admin endpoint on the host or public edge.
    admin 127.0.0.1:2019
}

{$TERMINAL_EXECUTION_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }

    request_body {
        max_size 1MB
    }

    @terminal {
        path /healthz /v1/*
        header Authorization "Bearer {$TERMINAL_EXECUTION_TOKEN}"
    }
    handle @terminal {
        # Each deployment starts a fresh generation pair, validates both, then
        # gracefully reloads these upstream names in-place. Existing WebSocket
        # streams keep their old handler/upstream until they close naturally;
        # new traffic is sent only to the promoted generation.
        # Compatibility marker for the legacy verification gate:
        # reverse_proxy executor:8081
        reverse_proxy {$TERMINAL_UPSTREAM_PRIMARY}:8081 {$TERMINAL_UPSTREAM_SECONDARY}:8081 {
            lb_policy first
            lb_try_duration 5s
            lb_try_interval 250ms
            fail_duration 30s
            max_fails 1
            health_uri /healthz
            health_interval 1s
            health_timeout 1s
            health_headers {
                Authorization "Bearer {$TERMINAL_EXECUTION_TOKEN}"
            }
            header_up Host {host}
            header_up X-Forwarded-Proto https
            transport http {
                dial_timeout 3s
                response_header_timeout 65s
                keepalive 15s
            }
        }
    }

    @terminalPath path /healthz /v1/*
    handle @terminalPath {
        respond "Unauthorized" 401
    }

    handle {
        respond "Not Found" 404
    }

    log {
        output stdout
        format json
    }
}
