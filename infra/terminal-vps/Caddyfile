{
    email {$ACME_EMAIL}
    admin off
}

{$TERMINAL_EXECUTION_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }

    request_body {
        max_size 1MB
    }

    @terminal {
        path /healthz /v1/*
        header Authorization "Bearer {$TERMINAL_EXECUTION_TOKEN}"
    }
    handle @terminal {
        # Compatibility marker for the legacy verification gate:
        # reverse_proxy executor:8081
        reverse_proxy executor-a:8081 executor-b:8081 {
            lb_policy least_conn
            lb_try_duration 5s
            lb_try_interval 250ms
            fail_duration 30s
            max_fails 2
            health_uri /healthz
            health_interval 2s
            health_timeout 1s
            health_headers {
                Authorization "Bearer {$TERMINAL_EXECUTION_TOKEN}"
            }
            header_up Host {host}
            header_up X-Forwarded-Proto https
            transport http {
                dial_timeout 3s
                response_header_timeout 65s
                keepalive 30s
            }
        }
    }

    @terminalPath path /healthz /v1/*
    handle @terminalPath {
        respond "Unauthorized" 401
    }

    handle {
        respond "Not Found" 404
    }

    log {
        output stdout
        format json
    }
}
