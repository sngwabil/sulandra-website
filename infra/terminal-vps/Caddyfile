{
    email {$ACME_EMAIL}
    admin off
}

{$TERMINAL_EXECUTION_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }

    request_body {
        max_size 1MB
    }

    @terminal path /healthz /v1/*
    handle @terminal {
        reverse_proxy executor:8081 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
            transport http {
                dial_timeout 5s
                response_header_timeout 65s
                keepalive 30s
            }
        }
    }

    handle {
        respond "Not Found" 404
    }

    log {
        output stdout
        format json
    }
}
