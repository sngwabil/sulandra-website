{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.database-cutover",
    "watchPatterns": [
      "Dockerfile.database-cutover",
      "scripts/database-provider-cutover.sh",
      "scripts/database-provider-cutover-launcher.sh",
      "railway.database-cutover.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "NEVER"
  }
}
