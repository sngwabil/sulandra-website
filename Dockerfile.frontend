FROM node:22-bookworm-slim

WORKDIR /app

COPY . .

RUN node scripts/optimize-admin-login-performance.mjs
RUN node scripts/install-employee-support.mjs

# Build a pinned same-origin browser terminal bundle containing xterm plus all
# production addons. No CDN runtime dependency is used in production.
RUN npm --prefix terminal-browser install --no-audit --no-fund \
 && npm --prefix terminal-browser run build

RUN node scripts/install-it-agent-conversational-ui.mjs \
 && node scripts/install-it-agent-xterm-emulator.mjs \
 && node scripts/fix-it-agent-status-board-api-origin.mjs \
 && node scripts/install-workspace-ide-ui.mjs

RUN node scripts/verify-workspace-same-origin-proxy.mjs

RUN npm run build:web \
 && mkdir -p dist-web/assets/vendor \
 && cp terminal-browser/dist/sulandra-terminal-runtime.js dist-web/assets/vendor/sulandra-terminal-runtime.js \
 && cp terminal-browser/node_modules/@xterm/xterm/css/xterm.css dist-web/assets/vendor/xterm.css \
 && cp terminal-browser/node_modules/@xterm/xterm/LICENSE dist-web/assets/vendor/XTERM-LICENSE \
 && cp assets/it-agent-workspace-preview.css dist-web/assets/it-agent-workspace-preview.css \
 && cp assets/it-agent-workspace-preview.js dist-web/assets/it-agent-workspace-preview.js \
 && cp assets/sulandra-codebase.css dist-web/assets/sulandra-codebase.css \
 && cp assets/sulandra-codebase.js dist-web/assets/sulandra-codebase.js \
 && cp assets/sulandra-codebase-api-bridge.js dist-web/assets/sulandra-codebase-api-bridge.js \
 && node scripts/install-it-agent-xterm-emulator.mjs \
 && node scripts/fix-it-agent-status-board-api-origin.mjs \
 && node scripts/install-workspace-ide-ui.mjs dist-web/it-solutions.html \
 && node scripts/verify-it-agent-artifact-capabilities.mjs

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

USER node

CMD ["node", "scripts/serve-static-site.mjs"]
