FROM node:22-bookworm-slim

WORKDIR /app

COPY . .

# DEVELOPMENT_WORKFLOW.md defines npm run build:web as the authoritative
# Sulandra Static Website build. Running build-static-site.mjs directly skipped
# the pre/post integration chain and silently published placeholder/legacy pages.
RUN npm run build:web

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

USER node

CMD ["node", "scripts/serve-static-site.mjs"]
