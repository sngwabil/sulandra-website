FROM postgres:18-bookworm

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      coreutils \
      diffutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /cutover

COPY scripts/database-provider-cutover.sh /cutover/scripts/database-provider-cutover.sh
COPY scripts/database-provider-cutover-launcher.sh /cutover/scripts/database-provider-cutover-launcher.sh
RUN sed -i 's|--dbname=\$SOURCE_DATABASE_URL|--dbname=${SOURCE_DATABASE_EFFECTIVE_URL:-$SOURCE_DATABASE_URL}|g' /cutover/scripts/database-provider-cutover.sh \
    && chown postgres:postgres \
      /cutover/scripts/database-provider-cutover.sh \
      /cutover/scripts/database-provider-cutover-launcher.sh \
    && chmod 0500 \
      /cutover/scripts/database-provider-cutover.sh \
      /cutover/scripts/database-provider-cutover-launcher.sh \
    && mkdir -p /tmp/sulandra-database-cutover \
    && chown -R postgres:postgres /tmp/sulandra-database-cutover

USER postgres

ENTRYPOINT ["/cutover/scripts/database-provider-cutover-launcher.sh"]
