FROM node:22-bookworm-slim

# Railway terminal service contract: this service must build this Dockerfile directly.
# A repository-root railway.json is intentionally forbidden because it can override
# this monorepo service during source-triggered deployments.
ARG NPM_VERSION=10.9.9

ENV NODE_ENV=production \
    PORT=8080

# Node 22.23.2 ships npm 10.9.8 with bundled tar 7.5.11 (CVE-2026-59873).
# Pin the patched npm 10 line; npm 10.9.9 bundles tar 7.5.22.
RUN npm install --global "npm@${NPM_VERSION}" --no-audit --no-fund \
    && test "$(npm --version)" = "${NPM_VERSION}"

WORKDIR /gateway
COPY coding-terminal-worker/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY coding-terminal-worker/server.mjs ./server.mjs
COPY scripts/install-terminal-gateway-ha.mjs /tmp/install-terminal-gateway-ha.mjs
COPY scripts/install-workspace-ide-live-preview.mjs /tmp/install-workspace-ide-live-preview.mjs
COPY scripts/fix-workspace-proxy-abort.mjs /tmp/fix-workspace-proxy-abort.mjs
COPY scripts/fix-workspace-proxy-streaming.mjs /tmp/fix-workspace-proxy-streaming.mjs
COPY scripts/fix-workspace-browser-session.mjs /tmp/fix-workspace-browser-session.mjs
COPY scripts/verify-workspace-browser-session.mjs /tmp/verify-workspace-browser-session.mjs
COPY scripts/fix-workspace-ticket-cors.mjs /tmp/fix-workspace-ticket-cors.mjs
COPY scripts/verify-workspace-ticket-cors.mjs /tmp/verify-workspace-ticket-cors.mjs
COPY scripts/install-terminal-history-proxy.mjs /tmp/install-terminal-history-proxy.mjs
COPY scripts/install-codebase-pty-compat.mjs /tmp/install-codebase-pty-compat.mjs
COPY scripts/install-codebase-pty-session-resume.mjs /tmp/install-codebase-pty-session-resume.mjs
COPY scripts/fix-codebase-async-pty-startup.mjs /tmp/fix-codebase-async-pty-startup.mjs
COPY scripts/fix-codebase-preview-owner-namespace.mjs /tmp/fix-codebase-preview-owner-namespace.mjs
COPY scripts/install-codebase-project-gateway.mjs /tmp/install-codebase-project-gateway.mjs
COPY scripts/harden-terminal-execution-http.mjs /tmp/harden-terminal-execution-http.mjs
RUN node /tmp/install-terminal-gateway-ha.mjs /gateway/server.mjs \
    && node /tmp/install-workspace-ide-live-preview.mjs /gateway/server.mjs \
    && node /tmp/fix-workspace-proxy-abort.mjs /gateway/server.mjs \
    && node /tmp/fix-workspace-proxy-streaming.mjs /gateway/server.mjs \
    && node /tmp/fix-workspace-browser-session.mjs /gateway/server.mjs \
    && node /tmp/fix-workspace-ticket-cors.mjs /gateway/server.mjs \
    && node /tmp/install-terminal-history-proxy.mjs /gateway/server.mjs \
    && node /tmp/install-codebase-pty-compat.mjs /gateway/server.mjs \
    && node /tmp/install-codebase-pty-session-resume.mjs /gateway/server.mjs \
    && node /tmp/fix-codebase-async-pty-startup.mjs /gateway/server.mjs \
    && node /tmp/fix-codebase-preview-owner-namespace.mjs /gateway/server.mjs \
    && node /tmp/install-codebase-project-gateway.mjs /gateway/server.mjs \
    && node /tmp/harden-terminal-execution-http.mjs /gateway/server.mjs \
    && node --check /gateway/server.mjs \
    && node /tmp/verify-workspace-browser-session.mjs /gateway/server.mjs \
    && node /tmp/verify-workspace-ticket-cors.mjs /gateway/server.mjs \
    && grep -Fq 'CODEBASE_PTY_COMPAT_V1' /gateway/server.mjs \
    && grep -Fq 'CODEBASE_PTY_SESSION_RESUME_V1' /gateway/server.mjs \
    && grep -Fq 'CODEBASE_ASYNC_PTY_STARTUP_V1' /gateway/server.mjs \
    && grep -Fq 'CODEBASE_PREVIEW_OWNER_NAMESPACE_V1' /gateway/server.mjs \
    && grep -Fq 'CODEBASE_PROJECT_GATEWAY_V1' /gateway/server.mjs \
    && grep -Fq 'TERMINAL_EXECUTION_HTTP_IPV4_V1' /gateway/server.mjs \
    && grep -Fq 'dispatcher: executionHttpDispatcher' /gateway/server.mjs \
    && grep -Fq "url.pathname === '/pty'" /gateway/server.mjs \
    && grep -Fq "app.get('/codebase/projects'" /gateway/server.mjs \
    && grep -Fq "app.post('/codebase/projects/clone'" /gateway/server.mjs \
    && grep -Fq "app.post('/codebase/projects/:project/railway/deploy'" /gateway/server.mjs \
    && rm -f /tmp/install-terminal-gateway-ha.mjs /tmp/install-workspace-ide-live-preview.mjs /tmp/fix-workspace-proxy-abort.mjs /tmp/fix-workspace-proxy-streaming.mjs /tmp/fix-workspace-browser-session.mjs /tmp/verify-workspace-browser-session.mjs /tmp/fix-workspace-ticket-cors.mjs /tmp/verify-workspace-ticket-cors.mjs /tmp/install-terminal-history-proxy.mjs /tmp/install-codebase-pty-compat.mjs /tmp/install-codebase-pty-session-resume.mjs /tmp/fix-codebase-async-pty-startup.mjs /tmp/fix-codebase-preview-owner-namespace.mjs /tmp/install-codebase-project-gateway.mjs /tmp/harden-terminal-execution-http.mjs

EXPOSE 8080
USER node
CMD ["node", "server.mjs"]
