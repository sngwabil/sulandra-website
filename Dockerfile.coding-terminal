FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PORT=8080 \
    TERMINAL_SEED_PATH=/seed \
    TERMINAL_WORKSPACE_ROOT=/workspaces

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash git curl ca-certificates build-essential python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /worker
COPY coding-terminal-worker/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY coding-terminal-worker/server.mjs ./server.mjs

RUN mkdir -p /seed /workspaces
COPY . /seed
RUN rm -rf /seed/.git /seed/node_modules /seed/api/node_modules /seed/api/dist /seed/dist-web /seed/coverage

WORKDIR /worker
EXPOSE 8080
CMD ["node", "server.mjs"]
