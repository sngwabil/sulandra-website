# Railway supplies PORT automatically.
PORT=4000
NODE_ENV=development

# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# HS256 secret used to sign and verify eight-hour employee bearer tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Bootstrap administrator sign-in. Employee accounts use database credentials.
ADMIN_EMAIL=admin@sulandrahealth.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-temporary-password
ADMIN_FIRST_NAME=Sulpitius
ADMIN_LAST_NAME=Gwabil
ORGANIZATION_NAME=Sulandra Health

# Sulandra 1.1 mandatory MFA baseline. The application independently requires MFA
# for Admin, PHI, clinical, compliance, scheduling, billing, and driver roles.
# Keep this explicit owner/admin switch enabled as an additional fail-closed safeguard.
ADMIN_SMS_MFA_REQUIRED=true
ADMIN_MFA_PHONE=+12135550123
# Optional dedicated HMAC pepper for one-time-code hashes. JWT_SECRET is used when omitted.
EMPLOYEE_SMS_MFA_PEPPER=replace-with-a-separate-long-random-secret
# SMS challenge lifetime and retry ceiling. These defaults are enforced server-side
# when the variables are omitted, but are documented here for production visibility.
EMPLOYEE_SMS_MFA_TTL_MINUTES=10
EMPLOYEE_SMS_MFA_MAX_ATTEMPTS=5

# Optional trusted service-to-service authentication.
SULANDRA_INTERNAL_API_KEY=replace-with-a-separate-long-random-secret

# Existing S.P.I.R.E. organization and administrator record IDs.
CAREERS_ORGANIZATION_ID=replace-with-organization-id
PRIMARY_ADMIN_USER_ID=replace-with-user-id

# Applicant portal, notification sender, and a separate applicant-session signing secret.
CAREERS_PORTAL_URL=https://www.sulandrahealth.com/applicant-portal.html
CAREERS_EMAIL_FROM=admin@sulandrahealth.com
APPLICANT_PORTAL_SECRET=replace-with-a-separate-long-random-secret

# Microsoft 365 app-only credentials for sending from CAREERS_EMAIL_FROM.
# Grant the application Mail.Send and restrict mailbox access to the Sulandra careers mailbox.
MICROSOFT_TENANT_ID=replace-with-microsoft-tenant-id
MICROSOFT_CLIENT_ID=replace-with-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret

# Alternative Office 365 SMTP delivery when Microsoft Graph is not configured.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=admin@sulandrahealth.com
SMTP_PASS=replace-with-the-mailbox-password
SMTP_FROM=admin@sulandrahealth.com

# Twilio SMS delivery. Sulandra 1.1 governed roles fail closed at sign-in when MFA
# is required but the destination phone or provider configuration is unavailable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Production adapter boundaries. Keep all activation flags disabled until the
# named external authority has approved the integration and evidence hashes are recorded.
# Secret values must live in Railway/Vault/cloud secret managers; only opaque references
# with railway://, vault://, aws-secretsmanager://, azure-keyvault://, or
# gcp-secretmanager:// schemes are accepted by these boundaries.

# CMS iQIES official XML upload/VUT/FVR certification workflow. No public OASIS
# machine API is assumed; automated transport remains disabled in application code.
IQIES_VENDOR_REGISTRATION_CONFIRMED=0
IQIES_HARP_ACCOUNT_APPROVED=0
IQIES_PROVIDER_SECURITY_OFFICIAL_APPROVED=0
IQIES_ASSESSMENT_SUBMITTER_ROLE_APPROVED=0
IQIES_CCN_REFERENCE=
IQIES_VUT_SPEC_VERSION=3.02
IQIES_ERROR_GUIDE_VERSION=2.4
IQIES_VUT_PASS_EVIDENCE_SHA256=
IQIES_SANDBOX_WORKFLOW_ENABLED=0

# Ohio Alternate EVV / Sandata interface specification 4.4.
OHIO_ALT_EVV_ENVIRONMENT=UAT
OHIO_ALT_EVV_VENDOR_REGISTERED=0
OHIO_ALT_EVV_PROVIDER_DESIGNATED=0
OHIO_ALT_EVV_SOD_USER_APPROVED=0
SANDATA_CREDENTIAL_REFERENCE=
SANDATA_INTERFACE_SPEC_VERSION=4.4
SANDATA_UAT_CERTIFICATION_EVIDENCE_SHA256=
SANDATA_UAT_ENABLED=0
SANDATA_PRODUCTION_CERTIFIED=0
SANDATA_PRODUCTION_ENABLED=0

# Payer or clearinghouse claim transport.
PAYER_CONNECTIVITY_MODE=DISABLED
PAYER_ENDPOINT_URL=
PAYER_ALLOWED_HOSTS=
PAYER_CREDENTIAL_REFERENCE=
PAYER_BAA_EVIDENCE_SHA256=
PAYER_TRADING_PARTNER_AGREEMENT_SHA256=
PAYER_COMPANION_GUIDE_SHA256=
PAYER_CONNECTIVITY_TEST_EVIDENCE_SHA256=
PAYER_PRODUCTION_ENABLED=0

# CMS HETS real-time 270/271 005010X279A1 transport.
HETS_TPA_APPROVED=0
HETS_SUBMITTER_ID_REFERENCE=
HETS_CREDENTIAL_REFERENCE=
HETS_PROVIDER_EDI_ENROLLMENT_VERIFIED=0
HETS_COMPANION_GUIDE_VERSION=15-1
HETS_CONNECTIVITY_GUIDE_VERSION=11-1
HETS_CONNECTIVITY_MODE=
HETS_TEST_APPROVAL_EVIDENCE_SHA256=
HETS_PRODUCTION_ENABLED=0

# HIPAA secure e-fax vendor boundary.
SECURE_FAX_MODE=DISABLED
SECURE_FAX_ENDPOINT_URL=
SECURE_FAX_ALLOWED_HOSTS=
SECURE_FAX_CREDENTIAL_REFERENCE=
SECURE_FAX_BAA_EVIDENCE_SHA256=
SECURE_FAX_SECURITY_REVIEW_EVIDENCE_SHA256=
SECURE_FAX_TEST_DELIVERY_EVIDENCE_SHA256=
SECURE_FAX_DESTINATION_VERIFICATION_POLICY_ACKNOWLEDGED=0
SECURE_FAX_MINIMUM_NECESSARY_POLICY_ACKNOWLEDGED=0
SECURE_FAX_PRODUCTION_ENABLED=0

# Drug terminology and label provenance. RxNorm and DailyMed do not replace a
# licensed, clinically validated drug-interaction/allergy decision-support source.
RXNORM_VERSION_EVIDENCE_SHA256=
DAILYMED_VERSION_EVIDENCE_SHA256=
DRUG_INTERACTION_MODE=DISABLED
DRUG_CLINICAL_SOURCE_LICENSE_EVIDENCE_SHA256=
DRUG_CLINICAL_VALIDATION_EVIDENCE_SHA256=
