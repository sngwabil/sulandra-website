# Railway supplies PORT automatically.
PORT=4000
NODE_ENV=development

# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# HS256 secret used to sign and verify eight-hour employee bearer tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Bootstrap administrator sign-in. Employee accounts use database credentials.
ADMIN_EMAIL=admin@sulandrahealth.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-temporary-password
ADMIN_FIRST_NAME=Sulpitius
ADMIN_LAST_NAME=Gwabil
ORGANIZATION_NAME=Sulandra Health

# Optional trusted service-to-service authentication.
SULANDRA_INTERNAL_API_KEY=replace-with-a-separate-long-random-secret

# Existing S.P.I.R.E. organization and administrator record IDs.
CAREERS_ORGANIZATION_ID=replace-with-organization-id
PRIMARY_ADMIN_USER_ID=replace-with-user-id

# Applicant portal, notification sender, and a separate applicant-session signing secret.
CAREERS_PORTAL_URL=https://www.sulandrahealth.com/applicant-portal.html
CAREERS_EMAIL_FROM=admin@sulandrahealth.com
APPLICANT_PORTAL_SECRET=replace-with-a-separate-long-random-secret

# Microsoft 365 app-only credentials for sending from CAREERS_EMAIL_FROM.
# Grant the application Mail.Send and restrict mailbox access to the Sulandra careers mailbox.
MICROSOFT_TENANT_ID=replace-with-microsoft-tenant-id
MICROSOFT_CLIENT_ID=replace-with-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-application-client-secret

# Optional SMS delivery when an applicant selects text messaging.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
