# Railway supplies PORT automatically.
PORT=4000
NODE_ENV=development

# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# HS256 secret used to verify employee bearer tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Optional trusted service-to-service authentication.
SULANDRA_INTERNAL_API_KEY=replace-with-a-separate-long-random-secret

# Existing SPIRE organization and administrator record IDs.
CAREERS_ORGANIZATION_ID=replace-with-organization-id
PRIMARY_ADMIN_USER_ID=replace-with-user-id
