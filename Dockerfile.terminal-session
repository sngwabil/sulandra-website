FROM node:22-bookworm-slim

ARG CODE_SERVER_VERSION=4.135.0
ARG CODE_SERVER_SHA256=300ef4e37e469e6368a4673c6a623e1c9ba8a34f42b394fb49c431a8900bc7d1
ARG NPM_VERSION=10.9.9
ARG BUN_VERSION=1.4.1

ENV NODE_ENV=production \
    NODE_USE_ENV_PROXY=1 \
    PORT=9000 \
    SULANDRA_IDE_PORT=13337 \
    SULANDRA_TERMINAL_CWD=/projects \
    TERMINAL_ROWS=12 \
    VSCODE_PROXY_URI=./proxy/{{port}} \
    HOME=/home/terminal \
    SHELL=/bin/bash \
    TERM=xterm-256color \
    COLORTERM=truecolor \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Full developer image for heavy software/app/game work. The terminal user may
# elevate to root *inside its own isolated session container* so apt/dpkg and
# build-system dependencies work normally. The session never receives the host
# Docker socket and the executor still enforces CPU/memory/PID boundaries.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash sudo git gh curl wget ca-certificates openssh-client rsync file \
      build-essential cmake clang lldb gdb valgrind strace pkg-config ninja-build \
      python3 python3-pip python3-venv \
      golang-go rustc cargo default-jdk-headless \
      postgresql-client default-mysql-client redis-tools sqlite3 \
      iproute2 net-tools dnsutils iputils-ping lsof procps \
      jq ripgrep less nano vim-tiny tmux tree zip unzip \
      libgl1-mesa-dev libglu1-mesa-dev libsdl2-dev libvulkan-dev \
      libx11-dev libxrandr-dev libxi-dev libxinerama-dev libxcursor-dev \
      libasound2-dev libpulse-dev xvfb ffmpeg \
    && groupadd --gid 10001 terminal \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash terminal \
    && printf '%s\n' \
      'terminal ALL=(ALL) NOPASSWD:ALL' \
      'Defaults:terminal env_keep += "HTTP_PROXY HTTPS_PROXY http_proxy https_proxy NO_PROXY no_proxy"' \
      > /etc/sudoers.d/terminal \
    && chmod 0440 /etc/sudoers.d/terminal \
    && visudo -cf /etc/sudoers.d/terminal \
    && curl -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz" -o /tmp/code-server.tar.gz \
    && echo "${CODE_SERVER_SHA256}  /tmp/code-server.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/code-server.tar.gz -C /opt \
    && test -x "/opt/code-server-${CODE_SERVER_VERSION}-linux-amd64/bin/code-server" \
    && ln -s "/opt/code-server-${CODE_SERVER_VERSION}-linux-amd64/bin/code-server" /usr/local/bin/code-server \
    && /usr/local/bin/code-server --version \
    && rm -f /tmp/code-server.tar.gz \
    && rm -rf /var/lib/apt/lists/*

# Node 22.23.2 ships npm 10.9.8 with bundled tar 7.5.11 (CVE-2026-59873).
# Pin the patched npm 10 line; npm 10.9.9 bundles tar 7.5.22.
RUN npm install --global "npm@${NPM_VERSION}" --no-audit --no-fund \
    && test "$(npm --version)" = "${NPM_VERSION}"

# Bun is installed from its official npm distribution and pinned so the terminal
# image stays reproducible instead of executing an unpinned remote install script.
RUN npm install --global "bun@${BUN_VERSION}" --no-audit --no-fund \
    && test "$(bun --version)" = "${BUN_VERSION}"

# Fail the image build if a supported compiler/runtime/database/network CLI disappears.
RUN set -eux; \
    for cmd in node npm yarn bun python3 pip3 gcc g++ make cmake clang go rustc cargo java javac git gh psql mysql redis-cli sqlite3 sudo ss netstat wget; do \
      command -v "$cmd" >/dev/null; \
    done; \
    node --version; npm --version; yarn --version; bun --version; \
    python3 --version; gcc --version | head -n1; g++ --version | head -n1; \
    make --version | head -n1; cmake --version | head -n1; clang --version | head -n1; \
    go version; rustc --version; cargo --version; java -version; javac -version; \
    git --version; gh --version | head -n1; psql --version; mysql --version; redis-cli --version; sqlite3 --version; \
    sudo -u terminal sudo -n id -u | grep -qx '0'

# Host isolation remains enforced by the executor: session containers are not
# privileged and never receive /var/run/docker.sock. Root access is intentionally
# limited to the disposable session container itself.
WORKDIR /agent
COPY terminal-session-agent/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY terminal-session-agent/server.mjs ./server.mjs
COPY scripts/install-session-agent-ide-bridge.mjs /tmp/install-session-agent-ide-bridge.mjs
COPY scripts/install-terminal-prompt-cursor.mjs /tmp/install-terminal-prompt-cursor.mjs
RUN node /tmp/install-session-agent-ide-bridge.mjs /agent/server.mjs \
    && node /tmp/install-terminal-prompt-cursor.mjs /agent/server.mjs \
    && node --check /agent/server.mjs \
    && rm -f /tmp/install-session-agent-ide-bridge.mjs /tmp/install-terminal-prompt-cursor.mjs
COPY terminal-session-agent/entrypoint.sh ./entrypoint.sh
COPY terminal-session-agent/bashrc ./bashrc
COPY scripts/verify-terminal-ide-settings.mjs /tmp/verify-terminal-ide-settings.mjs
RUN node /tmp/verify-terminal-ide-settings.mjs /agent/entrypoint.sh \
    && rm -f /tmp/verify-terminal-ide-settings.mjs
# /home/terminal is mounted as a tmpfs by the executor for each isolated session,
# so files baked into that path are hidden at runtime. Keep canonical shell/tmux
# configuration on the image and load/copy it when a session starts.
COPY terminal-session-agent/tmux.conf /agent/tmux.conf
COPY terminal-session-agent/github-login.sh /usr/local/bin/sulandra-github-login
COPY terminal-session-agent/create-pr.sh /usr/local/bin/sulandra-pr
RUN chmod 0755 /agent/entrypoint.sh /usr/local/bin/sulandra-github-login /usr/local/bin/sulandra-pr \
    && chmod 0644 /agent/tmux.conf /agent/bashrc \
    && bash --noprofile --norc -n /agent/bashrc \
    && profile_check="$(PROMPT_COMMAND='printf "\\033[?25h"' bash --noprofile --rcfile /agent/bashrc -ic 'printf "PS1=%s\n" "$PS1"; alias ls; type ok; printf "PROMPT_COMMAND=%s\n" "$PROMPT_COMMAND"' 2>/dev/null)" \
    && printf '%s\n' "$profile_check" | grep -q 'PS1=.*sulandra' \
    && printf '%s\n' "$profile_check" | grep -q "alias ls='ls --color=auto'" \
    && printf '%s\n' "$profile_check" | grep -q 'ok is a function' \
    && printf '%s\n' "$profile_check" | grep -q '__sulandra_update_git_prompt' \
    && mkdir -p /workspace /projects /home/terminal \
    && chown -R 10001:10001 /workspace /projects /home/terminal /agent

USER 10001:10001
WORKDIR /projects
EXPOSE 9000 13337
CMD ["bash", "-c", "install -m 0600 /agent/tmux.conf /home/terminal/.tmux.conf && exec /agent/entrypoint.sh"]
