FROM node:22-bookworm-slim

ARG CODE_SERVER_VERSION=4.135.0
ARG CODE_SERVER_SHA256=300ef4e37e469e6368a4673c6a623e1c9ba8a34f42b394fb49c431a8900bc7d1
ARG NPM_VERSION=10.9.9

ENV NODE_ENV=production \
    PORT=9000 \
    SULANDRA_IDE_PORT=13337 \
    VSCODE_PROXY_URI=./proxy/{{port}} \
    HOME=/home/terminal \
    SHELL=/bin/bash \
    TERM=xterm-256color \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash git gh curl ca-certificates build-essential python3 python3-pip python3-venv \
      jq ripgrep less nano vim-tiny procps tmux sqlite3 tree zip unzip rsync openssh-client \
    && groupadd --gid 10001 terminal \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash terminal \
    && curl -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz" -o /tmp/code-server.tar.gz \
    && echo "${CODE_SERVER_SHA256}  /tmp/code-server.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/code-server.tar.gz -C /opt \
    && ln -s "/opt/code-server-${CODE_SERVER_VERSION}-linux-amd64/bin/code-server" /usr/local/bin/code-server \
    && rm -f /tmp/code-server.tar.gz \
    && rm -rf /var/lib/apt/lists/*

# Node 22.23.2 ships npm 10.9.8 with bundled tar 7.5.11 (CVE-2026-59873).
# Pin the patched npm 10 line; npm 10.9.9 bundles tar 7.5.22.
RUN npm install --global "npm@${NPM_VERSION}" --no-audit --no-fund \
    && test "$(npm --version)" = "${NPM_VERSION}"

WORKDIR /agent
COPY terminal-session-agent/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY terminal-session-agent/server.mjs ./server.mjs
COPY scripts/install-session-agent-ide-bridge.mjs /tmp/install-session-agent-ide-bridge.mjs
RUN node /tmp/install-session-agent-ide-bridge.mjs /agent/server.mjs \
    && node --check /agent/server.mjs \
    && rm -f /tmp/install-session-agent-ide-bridge.mjs
COPY terminal-session-agent/entrypoint.sh ./entrypoint.sh
COPY terminal-session-agent/tmux.conf /home/terminal/.tmux.conf
COPY terminal-session-agent/github-login.sh /usr/local/bin/sulandra-github-login
COPY terminal-session-agent/create-pr.sh /usr/local/bin/sulandra-pr
RUN chmod 0755 /agent/entrypoint.sh /usr/local/bin/sulandra-github-login /usr/local/bin/sulandra-pr \
    && mkdir -p /workspace /home/terminal \
    && chown -R 10001:10001 /workspace /home/terminal /agent

USER 10001:10001
WORKDIR /workspace
EXPOSE 9000 13337
CMD ["/agent/entrypoint.sh"]
