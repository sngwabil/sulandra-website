{
  "name": "spire-ehr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=spire-api",
    "build": "npm run build --workspace=spire-api",
    "build:web": "node scripts/build-static-site.mjs",
    "start": "npm run start --workspace=spire-api",
    "typecheck": "npm run typecheck --workspace=spire-api",
    "check": "npm run db:validate && npm run typecheck && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:check-prerequisites": "node scripts/check-database-prerequisites.mjs",
    "db:verify-careers-schema": "node scripts/verify-careers-schema.mjs",
    "db:predeploy": "npm run db:check-prerequisites && npm run db:migrate:deploy && npm run db:verify-careers-schema"
  },
  "devDependencies": {
    "prisma": "^6.12.0"
  },
  "engines": {
    "node": "22.x"
  }
}
